    "quality_profile": "showcase",
    "views": [
      {
        "id": "happy-path",
        "label": "成功主路径",
        "focus": ["extract", "table_sel", "gen_sql", "exec_sql", "score", "gate", "viz"],
        "note": "抽取→选表→生成→执行→打分→门控→可视化"
      },
      {
        "id": "clarify",
