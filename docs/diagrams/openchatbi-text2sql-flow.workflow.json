  "cards": [
    {
      "dot": "cyan",
      "title": "子图与选表生成",
      "items": [
        "入口：sql_graph.build_sql_graph；主 Agent 经 text2sql 工具调用",
        "选表 schema_linking.py；生成/执行 generate_sql.create_sql_nodes"
      ]
    },
    {
      "dot": "amber",
      "title": "澄清 · 重试 · 门控",
      "items": [
        "澄清：AskHuman / search_knowledge 回 information_extraction",
        "score_sql→confidence_gate；enable_confidence_gate=false 时默认放行出图"
      ]
    }
  ]
