    { "id": "e-ex-rg", "from": "exec_sql", "to": "regen", "label": "失败→重写→再执行", "variant": "dashed", "role": "branch" },
    { "id": "e-sc-gt", "from": "score", "to": "gate", "variant": "default" },
    { "id": "e-gt-viz", "from": "gate", "to": "viz", "label": "approve", "variant": "emphasis" },
    { "id": "e-gt-rg", "from": "gate", "to": "regen", "label": "reject", "variant": "security", "role": "branch" }
